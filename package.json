{
  "name": "lc3sim",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "deploy": "vp build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lc3-simulator --local",
    "db:migrate:remote": "wrangler d1 migrations apply lc3-simulator --remote",
    "cf-typegen": "wrangler types",
    "auth:schema": "pnpm dlx auth@1.7.10 generate --config scripts/better-auth.config.ts --output src/server/db/auth-schema.ts --yes",
    "admin:create": "node --experimental-strip-types --no-warnings scripts/admin.ts create",
    "admin:reset": "node --experimental-strip-types --no-warnings scripts/admin.ts reset",
    "admin:delete": "node --experimental-strip-types --no-warnings scripts/admin.ts delete",
    "preview": "vp preview",
    "lint": "vp lint",
    "check:tailwind": "node scripts/tailwind-intellisense-diagnostics.mjs",
    "format": "vp fmt . && vp lint --fix",
    "check": "vp fmt --check .",
    "prepare": "vp config",
    "test:browser": "vp test --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/react-virtual": "^3.14.13",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "geist": "^1.7.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@inlang/paraglide-js": "^2.13.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/language-server": "^0.16.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "playwright": "1.57.0",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.151.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
