{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lc3-simulator",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "r2_buckets": [
    {
      "binding": "SUBMISSIONS",
      "bucket_name": "lc3-group-submissions",
    },
  ],
  "routes": [{ "pattern": "lc3.lgrum.xyz", "custom_domain": true }],
}
