{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lc3-simulator",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "assets": {
    "not_found_handling": "single-page-application",
    // Everything else is a static asset, served without running the Worker.
    "run_worker_first": ["/api/*", "/_serverFn/*"],
  },
  "vars": {
    // PBKDF2 iterations for new password hashes; see README "Password hashing".
    "PBKDF2_ITERATIONS": "7000",
  },
  // Secrets, set with `wrangler secret put` (and in .dev.vars locally):
  // BETTER_AUTH_SECRET, PASSWORD_PEPPER.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lc3-simulator",
      "database_id": "3cb27544-9e00-4a1d-8d27-8643b93d4c72",
      "migrations_dir": "drizzle",
    },
  ],
  "routes": [{ "pattern": "lc3.lgrum.xyz", "custom_domain": true }],
  // `wrangler dev` presents requests as coming to the route's domain; over
  // https, as in production, so Better Auth trusts their origin.
  "dev": { "upstream_protocol": "https" },
}
