{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lc3-simulator",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "assets": {
    "not_found_handling": "single-page-application",
    // Everything else is a static asset, served without running the Worker.
    "run_worker_first": ["/api/*", "/_serverFn/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lc3-simulator",
      // Replace with the id printed by `wrangler d1 create lc3-simulator`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "routes": [{ "pattern": "lc3.lgrum.xyz", "custom_domain": true }],
}
