{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lc3-simulator",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "lc3.lgrum.xyz", "custom_domain": true }],
}
